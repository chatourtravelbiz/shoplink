# Shoplink D1 — contoh env (tidak ada secret pembayaran)
# Semua nilai di bawah opsional. Tidak ada Stripe / Razorpay / billing di proyek ini.
# APP_URL dipakai untuk link toko di pesan WhatsApp (opsional).
APP_URL=http://localhost:8787

# Setelah `wrangler d1 create shoplink-d1`, salin database_id ke wrangler.toml.
# Setelah `wrangler r2 bucket create shoplink-d1-assets`, tidak ada env tambahan
# yang diperlukan — bucket di-bind lewat wrangler.toml.
